# Postgres — for local Docker, use the line below.
# For a hosted Postgres (Neon/Supabase), paste the connection string they give you
# (it already includes sslmode=require for Neon).
POSTGRES_DSN=postgresql://reading_radar:reading_radar@localhost:5432/reading_radar

# ClickHouse — for local Docker, use the values below.
# For ClickHouse Cloud: host is the "HTTPS endpoint" from your service's Connect page
# (looks like xxxxx.<region>.aws.clickhouse.cloud), port 8443, secure=true.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=reading_radar
CLICKHOUSE_DATABASE=reading_radar
CLICKHOUSE_SECURE=false

# Anthropic (used by backend/services/ai.py)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
